 "queries": {
  "app-rollout-failing-app-releases": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "app-rollout-failing-app-releases",
   "operations": [
    {
     "data_source": "datum_clickhouse",
     "raw_sql": "SELECT app, to_commit, countIf(status = 'failed') AS failed, count() AS total, anyIf(error, status = 'failed') AS error\nFROM\n(\n    SELECT\n        attributes['app'] AS app,\n        attributes['to_commit'] AS to_commit,\n        resource_id,\n        argMax(attributes['status'], ts) AS status,\n        argMax(message, ts) AS error\n    FROM logs\n    WHERE service = 'app_updates' AND attributes['app'] != '' AND attributes['to_commit'] != '' AND attributes['status'] IN ('success', 'failed') AND ts > now() - INTERVAL 7 DAY\n    GROUP BY app, to_commit, resource_id\n)\nGROUP BY app, to_commit\nHAVING failed > 0",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "Failing app releases",
   "use_live_connection": 1,
   "workbook": "app-rollout"
  },
  "app-rollout-release-results": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "app-rollout-release-results",
   "operations": [
    {
     "data_source": "datum_clickhouse",
     "raw_sql": "SELECT concat(app, ' ', substring(to_commit, 1, 8)) AS release, app, to_commit, countIf(status = 'failed') AS failed, countIf(status = 'success') AS succeeded, count() AS total, round(100 * countIf(status = 'failed') / count(), 1) AS failure_rate, min(last_at) AS started_at\nFROM (SELECT attributes['app'] AS app, attributes['to_commit'] AS to_commit, resource_id,\n  argMax(attributes['status'], ts) AS status, argMax(message, ts) AS error, max(ts) AS last_at\nFROM logs WHERE service = 'app_updates' AND attributes['app'] != '' AND attributes['to_commit'] != '' AND attributes['status'] IN ('success', 'failed') AND ts > now() - INTERVAL 30 DAY\nGROUP BY app, to_commit, resource_id) GROUP BY release, app, to_commit ORDER BY started_at",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "Release results",
   "use_live_connection": 1,
   "workbook": "app-rollout"
  },
  "app-rollout-top-update-errors": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "app-rollout-top-update-errors",
   "operations": [
    {
     "data_source": "datum_clickhouse",
     "raw_sql": "SELECT substring(error, 1, 70) AS error, app, to_commit, count() AS servers\nFROM (SELECT attributes['app'] AS app, attributes['to_commit'] AS to_commit, resource_id,\n  argMax(attributes['status'], ts) AS status, argMax(message, ts) AS error, max(ts) AS last_at\nFROM logs WHERE service = 'app_updates' AND attributes['app'] != '' AND attributes['to_commit'] != '' AND attributes['status'] IN ('success', 'failed') AND ts > now() - INTERVAL 30 DAY\nGROUP BY app, to_commit, resource_id) WHERE status = 'failed' GROUP BY error, app, to_commit ORDER BY servers DESC",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "Top update errors",
   "use_live_connection": 1,
   "workbook": "app-rollout"
  },
  "app-rollout-update-results-per-day": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "app-rollout-update-results-per-day",
   "operations": [
    {
     "data_source": "datum_clickhouse",
     "raw_sql": "SELECT toDate(last_at) AS day, app, to_commit, countIf(status = 'failed') AS failed, countIf(status = 'success') AS succeeded\nFROM (SELECT attributes['app'] AS app, attributes['to_commit'] AS to_commit, resource_id,\n  argMax(attributes['status'], ts) AS status, max(ts) AS last_at\nFROM logs WHERE service = 'app_updates' AND attributes['app'] != '' AND attributes['to_commit'] != '' AND attributes['status'] IN ('success', 'failed') AND ts > now() - INTERVAL 30 DAY\nGROUP BY app, to_commit, resource_id) GROUP BY day, app, to_commit ORDER BY day",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "Update results per day",
   "use_live_connection": 1,
   "workbook": "app-rollout"
  },
  "app-rollout-update-totals": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "app-rollout-update-totals",
   "operations": [
    {
     "data_source": "datum_clickhouse",
     "raw_sql": "SELECT app, to_commit, count() AS total, countIf(status = 'failed') AS failed, if(countIf(status = 'failed') > 0, 1, 0) AS has_failures\nFROM (SELECT attributes['app'] AS app, attributes['to_commit'] AS to_commit, resource_id,\n  argMax(attributes['status'], ts) AS status, argMax(message, ts) AS error, max(ts) AS last_at\nFROM logs WHERE service = 'app_updates' AND attributes['app'] != '' AND attributes['to_commit'] != '' AND attributes['status'] IN ('success', 'failed') AND ts > now() - INTERVAL 30 DAY\nGROUP BY app, to_commit, resource_id) GROUP BY app, to_commit",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "Update totals",
   "use_live_connection": 1,
   "workbook": "app-rollout"
  }
 },
