   "fetch_from": "client_team.team_name",
   "fieldname": "client_team_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Client",
   "read_only": 1
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "default": "Requested",
   "description": "Requested until it is answered. A team has one Requested or Active link at a time. Declined, Expired and Ended are final.",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "options": "Requested\nActive\nDeclined\nExpired\nEnded",
   "reqd": 1
  },
