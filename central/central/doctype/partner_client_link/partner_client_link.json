   "fieldname": "source_reference",
   "fieldtype": "Data",
   "label": "Connect Project",
   "read_only": 1,
   "depends_on": "eval:doc.source=='Connect'"
  },
  {
   "fieldname": "project_title",
   "fieldtype": "Data",
   "label": "Project Title",
   "read_only": 1,
   "depends_on": "eval:doc.source=='Connect'",
   "description": "The project name the customer sees."
  },
  {
   "fieldname": "column_break_source",
   "fieldtype": "Column Break"
  },
  {
   "description": "The customer team member who asked for a Partner Code link.",
