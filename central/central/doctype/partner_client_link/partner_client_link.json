   "fieldname": "paid_by_partner",
   "fieldtype": "Check",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Partner Pays"
  },
  {
   "default": "0",
   "fieldname": "partner_access",
   "fieldtype": "Check",
   "label": "Partner Access",
   "in_list_view": 1,
   "in_standard_filter": 1,
