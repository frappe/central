   "fieldtype": "Link",
   "label": "Requested By",
   "options": "User",
   "read_only": 1,
   "depends_on": "eval:doc.source=='Partner Code'"
  },
  {
   "fieldname": "customer_email",
   "fieldtype": "Data",
   "options": "Email",
   "label": "Customer Email",
   "read_only": 1,
   "depends_on": "eval:doc.source=='Connect'",
   "description": "Only a user signed in with this email can answer the link."
  },
  {
   "fieldname": "return_url",
   "fieldtype": "Data",
   "options": "URL",
   "label": "Return URL",
   "read_only": 1,
   "depends_on": "eval:doc.source=='Connect'",
   "description": "Where the customer goes back to in Connect. It is always on the Connect URL in Central Settings."
  },
  {
   "fieldname": "token_hash",
   "fieldtype": "Data",
   "label": "Token Hash",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "unique": 1,
   "description": "SHA-256 of the key in the customer's setup link. Central keeps only the hash."
  },
  {
   "fieldname": "section_billing",
   "fieldtype": "Section Break",
   "label": "Billing"
  },
  {
   "default": "0",
