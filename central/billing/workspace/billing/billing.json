 "content": "[{\"id\": \"hdr_title\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Billing \\u2014 Catalog Administration</b></span>\", \"col\": 12}}, {\"id\": \"how_it_works\", \"type\": \"paragraph\", \"data\": {\"text\": \"<b>How it works.</b> A <b>Plan</b> is something you sell, inside a <b>Family</b> (Plan Category). It lists <b>what's included</b> and its <b>price per currency</b>. A <b>metered add-on</b> is a plan that includes an <b>allowance</b>, then charges <b>per unit over it</b>. You never edit the raw tables: the <b>Plan Configurator</b> is the one guided form that writes a plan, an add-on, and its prices together. Use a verb below to launch, re-price, or retire an offering.\", \"col\": 12}}, {\"id\": \"hdr_tasks\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Do a task</b></span>\", \"col\": 12}}, {\"id\": \"sc_launch_plan\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Launch a plan\", \"col\": 3}}, {\"id\": \"sc_launch_addon\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Launch an add-on (metered)\", \"col\": 3}}, {\"id\": \"sc_update_prices\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Update prices\", \"col\": 3}}, {\"id\": \"sc_retire\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Retire a plan / add-on\", \"col\": 3}}, {\"id\": \"hdr_glance\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>At a glance</b></span>\", \"col\": 12}}, {\"id\": \"sc_metered\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Metered add-ons\", \"col\": 4}}, {\"id\": \"sc_plans\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"All plans\", \"col\": 4}}, {\"id\": \"hdr_records\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Records</b></span>\", \"col\": 12}}, {\"id\": \"card_revenue\", \"type\": \"card\", \"data\": {\"card_name\": \"Revenue\", \"col\": 4}}, {\"id\": \"card_credits\", \"type\": \"card\", \"data\": {\"card_name\": \"Credits\", \"col\": 4}}, {\"id\": \"card_subs\", \"type\": \"card\", \"data\": {\"card_name\": \"Subscriptions & Usage\", \"col\": 4}}, {\"id\": \"card_payments\", \"type\": \"card\", \"data\": {\"card_name\": \"Payments & Gateways\", \"col\": 4}}, {\"id\": \"card_customer\", \"type\": \"card\", \"data\": {\"card_name\": \"Customer Configuration\", \"col\": 4}}, {\"id\": \"card_notifications\", \"type\": \"card\", \"data\": {\"card_name\": \"Notifications\", \"col\": 4}}, {\"id\": \"hdr_advanced\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Advanced</b></span>\", \"col\": 12}}, {\"id\": \"card_advanced\", \"type\": \"card\", \"data\": {\"card_name\": \"Advanced (catalog masters)\", \"col\": 4}}, {\"id\": \"card_trust\", \"type\": \"card\", \"data\": {\"card_name\": \"Trust & Entitlements\", \"col\": 4}}]",
